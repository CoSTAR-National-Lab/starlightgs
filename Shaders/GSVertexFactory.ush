//general input
struct FVertexFactoryInput
{
    uint VertexId : SV_VertexID;

#if USE_INSTANCING
	#undef GetInstanceIdFromVF
	#define GetInstanceIdFromVF(VFInput)				(VFInput.InstanceId)
	uint InstanceId	: SV_InstanceID;
#else
