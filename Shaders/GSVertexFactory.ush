float3x3 VecToScaleMatrix(in float3 Scale)
{
    return float3x3(
		Scale.x, 0.0f, 0.0f,
		0.0f, Scale.y, 0.0f,
		0.0f, 0.0f, Scale.z
	);
}

//Compute Tangent

void GetTangents(float Rotation, out float3 OutRight, out float3 OutUp)
{
    float3 ResolvedViewRight = ResolvedView.ViewRight;
    float3 ResolvedViewUp = ResolvedView.ViewUp;

	// The standard camera facing vectors
    float3 CameraRight = ResolvedViewRight;
    float3 CameraUp = -ResolvedViewUp;
    float3 CameraFacingVector = -ResolvedView.ViewForward;

    float3 Right = CameraRight.xyz;
    float3 Up = CameraUp.xyz;

	// Determine the angle of rotation.
    float SinRotation;
    float CosRotation;
    sincos(Rotation, SinRotation, CosRotation);

    float3 SR = Right * SinRotation;
    float3 SU = Up * SinRotation;
    float3 CR = Right * CosRotation;
    float3 CU = Up * CosRotation;
    OutRight = SU + CR;
    OutUp = CU - SR;
}

/**
 * Projects splat into screen space based off of view provided
 */
void ComputeSplatParameters(
	in FPrimitiveSceneData Primitive, 
	in uint SplatIndex,
    out float2 OutSize,
    out float OutRotation, 
    out float3 OutWorldNormal,
    out float3 OutMeanWS, 
    out float3 OutMeanCS, 
    out float3 OutConic
)
{
    float3 LocalPosition = GSResources.Positions[SplatIndex];
	float4 TranslatedWorldPosition = TransformLocalToTranslatedWorld(LocalPosition, Primitive.LocalToWorld);

    OutMeanWS = TranslatedWorldPosition.xyz;

    //float3x3 ScaleMatrix = VecToScaleMatrix(GSResources.Scales[SplatIndex] * Primitive.NonUniformScale.xyz * Primitive.NonUniformScale.xyz);
    //float3x3 RotationMatrix = mul(DFToFloat3x3(Primitive.LocalToWorld), QuatToMatrix(GSResources.Orientations[SplatIndex]));

	float3 Scale = float3(0.025f, 0.01f, 0.01f);
	FQuat Rotation = QuatFromAxisAngle(float3(0, 0, 1), 0.0f);

	float3x3 ScaleMatrix = VecToScaleMatrix(Scale * Primitive.NonUniformScale.xyz * Primitive.NonUniformScale.xyz);
	float3x3 RotationMatrix = mul(DFToFloat3x3(Primitive.LocalToWorld), QuatToMatrix(Rotation));

	// Calculate covariance matrix
    float3x3 T = mul(RotationMatrix, ScaleMatrix);
    float3x3 Covariance3D = mul(T, transpose(T));

    // Fixes all the maths...
    TranslatedWorldPosition.xyz *= 0.01f;

    float4 ViewPosition = mul(TranslatedWorldPosition, ResolvedView.TranslatedWorldToView);

    float4 ClipPosition = mul(ViewPosition, ResolvedView.ViewToClip);
    ClipPosition /= ClipPosition.w;

	// Calculate Jacobian matrix based off of projection matrix
	// Jacobian calculation based off of https://jtstephens18.github.io/posts/Building-a-Gaussian-Splatting-Renderer-In-OpenGL/
    float FocalZ = ResolvedView.ViewSizeAndInvSize.y / (2.0f * ResolvedView.TanAndInvTanHalfFOV.y);

    float LimX = 1.3f * ResolvedView.TanAndInvTanHalfFOV.x;
    float LimY = 1.3f * ResolvedView.TanAndInvTanHalfFOV.y;

    float TxTz = ViewPosition.x / ViewPosition.z;
    float TyTz = ViewPosition.y / ViewPosition.z;

	// Clamped versions of TxTz and TyTz 
    float Tx = min(LimX, max(-LimX, TxTz)) * ViewPosition.z;
    float TY = min(LimY, max(-LimY, TyTz)) * ViewPosition.z;

    float3x3 J = float3x3(
		        FocalZ / ViewPosition.z, 0.0f, -(FocalZ * Tx) / (ViewPosition.z * ViewPosition.z),
		        0.0f, FocalZ / ViewPosition.z, -(FocalZ * TY) / (ViewPosition.z * ViewPosition.z),
				0.0f, 0.0f, 0.0f
			);

    //USING INVERSE OF VIEW HERE
    float3x3 JW = mul(J, transpose((float3x3) ResolvedView.TranslatedWorldToView));
    float3x3 Covariance2D = mul(JW, mul(transpose(Covariance3D), transpose(JW)));

    float X = Covariance2D[0][0] + 0.3f;
    float Y = Covariance2D[1][1] + 0.3f;
    float Covariance = Covariance2D[0][1];

	// Determine conic for the splat
    float Determinant = X * Y - Covariance * Covariance;
    float3 Conic = float3(Y, Covariance, X) / Determinant;
	
	// Finally calculate the bounds of a screenspace quad that will be rasterized for this splat
    float Mid = (X + Y);
    float Delta = length(float2((X - Y), (2 * Covariance)));
			
    float Lambda1 = 0.5f * (Mid + Delta);
    float Lambda2 = 0.5f * (Mid - Delta);

    if (Lambda2 > 0.0f)
    {
        OutRotation = 360 * atan2(Lambda1 - X, Covariance) / (2 * PI);

        float2 Size = float2(Lambda1, Lambda2);

        OutSize = Size * ViewPosition.z * max(ResolvedView.TanAndInvTanHalfFOV.x, ResolvedView.TanAndInvTanHalfFOV.y);

        float3 LocalNormal = GSResources.Normals[SplatIndex];
        OutWorldNormal = RotateLocalToWorld(LocalNormal, Primitive.LocalToWorld, Primitive.InvNonUniformScale);

        OutMeanCS = ClipPosition.xyz;
        OutConic = Conic;
    }
    else
    {
        OutSize = float2(0, 0);
        OutRotation = 0;
        OutMeanCS = float3( 0, 0, 0);
        OutMeanWS = float3( 0, 0, 0);
        OutWorldNormal = float3(0, 0, 0);
    }
}

/** Attributes to interpolate from the vertex shader to the pixel shader. */
struct FVertexFactoryInterpolantsVSToPS
{
    float3 MeanCS : MEAN;
    float3 Conic : CONIC;
    float  Opacity : OPACITY;

#if NUM_TEX_COORD_INTERPOLATORS
	float4 TexCoords[(NUM_TEX_COORD_INTERPOLATORS + 1) / 2] : TEXCOORD0;
#endif
};

/** Compute the intermediates for a given vertex. */
FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
    FVertexFactoryIntermediates Intermediates;
    Intermediates.SceneData = VF_GPUSCENE_GET_INTERMEDIATES(Input);

	static float2 Quad[4] =
	{
		float2(-1, -1),
		float2(-1, 1),
		float2(1, -1),
		float2(1, 1)
	};

    uint SplatIndex = Input.VertexId / 4;

    Intermediates.LocalPos = float4(Quad[Input.VertexId % 4], 0, 1);

#if VIRTUAL_SM_ENABLED
	uint PackedPageInfo = InstanceCulling_PageInfoBuffer[Intermediates.SceneData.InstanceIdLoadIndex];
	FPageInfo PageInfo = UnpackPageInfo(PackedPageInfo);
	FNaniteView NaniteView = UnpackNaniteView(ShadowDepthPass_PackedNaniteViews[PageInfo.ViewId]);

    float4 Position = float4(GSResources.Positions[SplatIndex], 0);
    Intermediates.WorldPosition = DFTransformLocalToTranslatedWorld(
		Position.xyz + Intermediates.LocalPos.xyz,
        Intermediates.SceneData.Primitive.LocalToWorld,
        ResolvedView.PreViewTranslation
    );
#else
    float2 SplatSize;
    float  SplatRotation;
    float3 SplatNormal;
    float3 SplatMeanWS;
    float3 SplatMeanCS;
    float3 SplatConic;

    ComputeSplatParameters(Intermediates.SceneData.Primitive, SplatIndex, SplatSize, SplatRotation, SplatNormal, SplatMeanWS, SplatMeanCS, SplatConic);

    float3 Up = float3(1, 0, 0);
    float3 Right = float3(0, 1, 0);
	SplatSize = float2(1.0f, 1.0f);
    //GetTangents(SplatRotation, Right, Up);

	Intermediates.WorldPosition = float4(SplatMeanWS + Intermediates.LocalPos.xyz, 1);

    Intermediates.Normal = SplatNormal;
    Intermediates.Conic = SplatConic;
    Intermediates.MeanCS = SplatMeanCS;
	Intermediates.Opacity = GSResources.SHAndOpacities[SplatIndex].w;
#endif

	Intermediates.Normal = 0;
	Intermediates.Conic = 0;
	Intermediates.MeanCS = 0;
	Intermediates.Opacity = 1;

    return Intermediates;
}

// RHI_RAYTRACING
#if COMPUTESHADER || RAYHITGROUPSHADER
FVertexFactoryInput LoadVertexFactoryInputForHGS(uint TriangleIndex, int VertexIndex)
{
	// For 4 verts cutout geometry and normal particle geometry, use the typical 6 indices
	FVertexFactoryInput Input;
	
	uint IndexBuffer[6] = { 0, 2, 3, 0, 1, 2 };
	uint VertexId = IndexBuffer[(TriangleIndex * 3 + VertexIndex) % 6];
	
	Input.VertexId = VertexId;
	Input.InstanceId = TriangleIndex / 2;
	
	return Input;
}

FVertexFactoryInput LoadVertexFactoryInputForDynamicUpdate(uint TriangleIndex, int VertexIndex, uint PrimitiveId, uint DrawInstanceId)
{
	return LoadVertexFactoryInputForHGS(TriangleIndex, VertexIndex);
}
uint GetNumRayTracingDynamicMeshVerticesIndirect()
{
	const uint NumVertices = 4;
	const uint NumInstances = 1; //GSResources.SplatCount;
	return NumVertices * NumInstances;
}
#endif

float3 VertexFactoryGetPreviousInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates);
float3 VertexFactoryGetInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates);

/** Converts from vertex factory specific input to a FMaterialVertexParameters, which is used by vertex shader material inputs. */
FMaterialVertexParameters GetMaterialVertexParameters(
	FVertexFactoryInput Input,
	FVertexFactoryIntermediates Intermediates,
	float3 WorldPosition,
	half3x3 TangentToLocal,
	bool bIsPreviousFrame = false)
{
    FMaterialVertexParameters Result = MakeInitializedMaterialVertexParameters();

    Result.SceneData = Intermediates.SceneData;
	
    Result.WorldPosition = WorldPosition;
    if (bIsPreviousFrame)
    {
        Result.PositionInstanceSpace = VertexFactoryGetPreviousInstanceSpacePosition(Input, Intermediates);
    }
    else
    {
        Result.PositionInstanceSpace = VertexFactoryGetInstanceSpacePosition(Input, Intermediates);
    }
    Result.PositionPrimitiveSpace = Result.PositionInstanceSpace; // No support for instancing, so instance == primitive

    Result.TangentToWorld = TangentToLocal; //Local is world, particles are generated in WS

    Result.PreSkinnedPosition = WorldPosition; 
    Result.PreSkinnedNormal = float3(0, 0, 1);


#if NUM_MATERIAL_TEXCOORDS_VERTEX
	UNROLL
	for (int CoordinateIndex = 0; CoordinateIndex < NUM_MATERIAL_TEXCOORDS_VERTEX; CoordinateIndex++)
	{
		Result.TexCoords[CoordinateIndex] = Intermediates.LocalPos.xy * 0.5f + 0.5f;
	}
#endif  //NUM_MATERIAL_TEXCOORDS_VERTEX

    Result.LWCData = MakeMaterialLWCData(Result);

    return Result;
}

