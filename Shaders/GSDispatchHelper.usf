#include "/Engine/Private/Common.ush"

Buffer<uint> CountBuffer;
RWBuffer<uint> RWIndirectArgs;

uint GroupDivisor;

[numthreads(1, 1, 1)]
void GSSetupIndirectArgsCS()
{
	uint NumThreads = CountBuffer[0];
	RWIndirectArgs[0] = (NumThreads + GroupDivisor - 1) / GroupDivisor;
	RWIndirectArgs[1] = 1;
	RWIndirectArgs[2] = 1;
}
