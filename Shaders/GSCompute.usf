// Check isnan(value) before use.
uint order_preserving_float_map(float value)
{
    // For negative values, the mask becomes 0xffffffff.
    // For positive values, the mask becomes 0x80000000.
    uint uvalue = asuint(value);
    uint mask = -int(uvalue >> 31) | 0x80000000;
    return uvalue ^ mask;
}

float inverse_order_preserving_float_map(uint value)
{
    // If the msb is set, the mask becomes 0x80000000.
    // If the msb is unset, the mask becomes 0xffffffff.
    uint mask = ((value >> 31) - 1) | 0x80000000;
    return asfloat(value ^ mask);
}

//out

RWBuffer<uint> Counter;
RWBuffer<float2> OutSSPositions;
RWBuffer<float4> OutSSScale;
RWStructuredBuffer<float3> OutConic;
RWBuffer<float4> OutColorOpacity;

RWBuffer<float> OutDepth;
RWBuffer<uint> OutGaussianIDX;


#define TILE_SIZE_X 16
#define TILE_SIZE_Y 16
#define TILE_SIZE TILE_SIZE_X*TILE_SIZE_Y

float3x3 VecToScaleMatrix(in float3 Scale)
{
	float3x3 OutMatrix;

    OutMatrix[0][0] = Scale.x;
    OutMatrix[1][1] = Scale.y;
    OutMatrix[2][2] = Scale.z;

    OutMatrix[1][0] = 0.0f;
    OutMatrix[2][0] = 0.0f;

    OutMatrix[0][1] = 0.0f;
    OutMatrix[2][1] = 0.0f;

    OutMatrix[0][2] = 0.0f;
    OutMatrix[1][2] = 0.0f;

    return OutMatrix;
}


float2x2 InverseMat2(float2x2 m)
{
	float det = m[0][0] * m[1][1] - m[0][1] * m[1][0];
	float2x2 inv;

	if (det != 0)
	{
		inv[0][0] =  m[1][1] / det;
		inv[0][1] = -m[0][1] / det;
		inv[1][0] = -m[1][0] / det;
		inv[1][1] =  m[0][0] / det;
	}
	else
		inv = 0.0f;

	return inv;
}

//Mixed Rendering Pipeline
//1. GSPrepass // most from niagara script
//2. Sort by view depth
//3. SplatRasterization (VS+PS) - Renders each splat as a billboard, writing out the depth and color of each splat to the GBuffer

[numthreads(256,1,1)]
void GSPrepass(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
    //init counter
    if (DispatchThreadId.x == 0)
    {
        //uint32 VertexCountPerInstance;
        //uint32 InstanceCount;
        //uint32 StartVertexLocation;
        //uint32 StartInstanceLocation;

        Counter[0] = 6; // 6 vertices for a quad in a trilist
    }

	//Terminate if we are outside the bounds of our input data
    if (DispatchThreadId.x >= GSResources.SplatCount)
		return;

    //ViewState ResolvedView = ResolveView();
    float4x4 ViewMatrix = PrimaryView.TranslatedWorldToView;
    float4x4 InvViewMatrix = PrimaryView.ViewToTranslatedWorld;
    float4x4 ViewToClip = PrimaryView.ViewToClip;
    float4x4 ClipToView = PrimaryView.ClipToView;

    float2 ViewSize = PrimaryView.ViewSizeAndInvSize.xy;

    float3 Position = GSResources.Positions[DispatchThreadId.x];

    float4 TranslatedPosition = DFTransformLocalToTranslatedWorld(Position, MakeDFMatrix4x3(Primitive.PositionHigh, Primitive.LocalToRelativeWorld), PrimaryView.PreViewTranslation);

    //apply correct scale because UU
    TranslatedPosition.xyz *= 0.01f;

    float4 ViewPosition = mul(TranslatedPosition, ViewMatrix);

	float4 ClipPosition = mul(TranslatedPosition, mul(ViewMatrix, ViewToClip));

    //cull depending on how far outside the screen we are
    float clip = 1.05 * ClipPosition.w; //Need to see how conservative that

    if (ClipPosition.z < -clip || ClipPosition.x < -clip || ClipPosition.x > clip || ClipPosition.y < -clip || ClipPosition.y > clip)
    {
        return;
    }
	
	//perspective divide to get NDC space
    ClipPosition.xyz = ClipPosition.xyz / ClipPosition.w;

	float3 Scale = GSResources.Scales[DispatchThreadId.x];
	float4 Rot = GSResources.Orientations[DispatchThreadId.x];

	float3x3 ScaleMatrix = VecToScaleMatrix(Scale * 2.f);
	float3x3 RotationMatrix = QuatToMatrix(Rot);

	RotationMatrix = mul((float3x3) Primitive.RelativeWorldToLocal, RotationMatrix);

    /*
    float2 TanHalfFov = float2(ClipToView[0][0], ClipToView[1][1]);

    float2 focalL = (ViewSize * 0.5) / TanHalfFov;

    float ViewZ = ViewPosition.z / ViewPosition.w;

    float2 focal_legth_perZ = focalL / ViewZ;

    float2 ViewposPerZ = ViewPosition.xy / ViewPosition.z;

    float2 focalperzz = focal_legth_perZ * clamp(ViewposPerZ, -TanHalfFov, TanHalfFov);

	float3x3 J = float3x3(
	    focal_legth_perZ.x, 0.f, 0.0f,
	    0.f, -focal_legth_perZ.x, 0.0f,
	    -focalperzz.x, focalperzz.y, 0.f
	);
	*/

	float tzSq = ViewPosition.z * ViewPosition.z;
	float jsx = -(ViewToClip[0][0] * ViewSize.x) / (2 * ViewPosition.z);
	float jsy = -(ViewToClip[1][1] * ViewSize.y) / (2 * ViewPosition.z);
	float jtx = (ViewToClip[0][0] * ViewPosition.x * ViewSize.x) / (2 * tzSq);
	float jty = (ViewToClip[1][1] * ViewPosition.y * ViewSize.y) / (2 * tzSq);

	float3x3 J = float3x3(jsx, 0.0f, jtx,
                          0.0f, jsy, jty,
                          0.0f, 0.0f, 0.0f);

	float3x3 m = mul(RotationMatrix, ScaleMatrix);
	float3x3 cov3d = mul(m, transpose(m));

	float3x3 JW = mul((float3x3) ViewMatrix, J);
	float3x3 A = mul(transpose(JW), mul(cov3d, JW));

	A[0][0] += 0.3;
	A[1][1] += 0.3;
    float X = A[0][0];
	float Y = A[1][1];
    float covariance = A[1][0];

    float3 Covariance2D = float3(X, covariance, Y);
    float det = X * Y - covariance * covariance;
    float3 Conic = Covariance2D / det;

	// TODO: This is a hacky hack that fixes things at the moment
	Conic.xz = Conic.zx;
	//float2x2 ConicMatrix = InverseMat2((float2x2) A);
	//float3 Conic = float3(ConicMatrix[0][0], ConicMatrix[0][1], ConicMatrix[1][1]);
    
    float mid = (X + Y);

	float delta = length(float2((X - Y), (2 * covariance)));
	
    float lambda1 = 0.5 * (mid + delta);
    float lambda2 = 0.5 * (mid - delta);

    if (lambda2 < 0.0)
    {
        return;
    }

	float2 diagonalVector = normalize(float2((covariance - Y + lambda1), (-X + covariance + lambda1)));
    float2 majorAxis = min(3 * sqrt(lambda1), 1024.0) * diagonalVector;
    float2 minorAxis = min(3 * sqrt(lambda2), 1024.0) * float2(diagonalVector.y, -diagonalVector.x);
	
    float2 majorAxisMultiplier = majorAxis / (ViewSize * 0.5);
    float2 minorAxisMultiplier = minorAxis / (ViewSize * 0.5);

    //IndirectARGS
    // uint32 VertexCountPerInstance;
    // uint32 InstanceCount;
    // uint32 StartVertexLocation;
    // uint32 StartInstanceLocation;
    uint idx = 0;
    InterlockedAdd(Counter[1], 1, idx);

    OutSSPositions[idx] = ClipPosition.xy;
    OutSSScale[idx] = float4(majorAxisMultiplier, minorAxisMultiplier);
    OutConic[idx] = Conic;
    
    OutDepth[idx] = ~order_preserving_float_map(ViewPosition.z);
    OutGaussianIDX[idx] = idx;
    OutColorOpacity[idx].xyz = GSResources.SHAndOpacities[DispatchThreadId.x].xyz * 0.282095 + 0.5; // can be baked into the import
    OutColorOpacity[idx].a = GSResources.SHAndOpacities[DispatchThreadId.x].a;
}

Buffer<float2> VS_SSPositions;
Buffer<float4> VS_SSScale;
StructuredBuffer<float3> VS_Conic;
Buffer<float4> VS_ColorOpacity;

Buffer<float> VS_Depth;
Buffer<uint> VS_GaussianIDX;

struct OutVertex
{
	float4 Position : SV_POSITION;
    float2 UVCoord : TEXCOORD0;

    float3 Color : COLOR;
	float3 Conic : CONIC;
    float Opacity : OPACITY;
    nointerpolation float2 Mean : MEAN;
	
	//float3 out_wsPos : SV_WSPOS;
	//float out_depth : SV_DEPTH;
	//float2 metallicRoughness : SV_METALLICROUGHNESS;
};

OutVertex GSSplatting_VS( in uint GlobalVertexId : SV_VertexID, in uint InstanceID : SV_InstanceID )
{
	float2 Quad[6] = 
    {
		float2(-1, -1),
		float2(-1, 1),
		float2(1, 1),

		float2(-1, -1),
		float2(1, 1),
		float2(1, -1)
	};

    uint index = VS_GaussianIDX[InstanceID];

    OutVertex output;
    output.Color = VS_ColorOpacity[index].rgb * VS_ColorOpacity[index].a;
    output.Opacity = VS_ColorOpacity[index].a;

    float3 Conic = VS_Conic[index];

	output.Conic = float3(-0.5 * Conic.x, -Conic.y, -0.5 * Conic.z);
    output.UVCoord = (Quad[GlobalVertexId] + 1) * 0.5;

    float4 quadscale = VS_SSScale[index];
    float2 sspos = VS_SSPositions[index];
    float2 vertex = Quad[GlobalVertexId];

	output.Mean = float2((float2(sspos.x, -sspos.y) + 1) * 0.5 * PrimaryView.ViewSizeAndInvSize.xy);
    output.Position = float4(sspos.xy + (vertex.x * quadscale.zw + vertex.y * quadscale.xy), 0, 1);
    //output.Position = float4(sspos.xy + (vertex.x * float2(1, 1) + vertex.y * float2(-1,-1)), 0, 1);

    //output.Position = float4(sspos.xy + vertex.xy * 0.01, 0, 1);

    //output.Color = float3(1, 1, 1);
    //output.Opacity = 1;
    //output.Conic = float3(1, 1, 1);
    //output.UVCoord = float2(1, 1);

   // output.Position = float4(vertex.xy, 0, 1);

    return output;
}


 
float4 GSSplatting_PS(in OutVertex input) : SV_TARGET
{
    float2 d = (input.Mean.xy - input.Position.xy);
    float alpha = dot(input.Conic.xzy, float3(d * d, d.x * d.y));
    float g = exp(alpha);
    //
    //if (u_renderMode == 4)

    //    gAlbedo = vec4(.01, .005, 0, .01);
    //else

	//return float4(g, 0, 0, 1);
    //return float4(1,1,1, 1) * g;

	return float4(input.Color, input.Opacity) * g;
	//return float4(input.UVCoord, 0, 1);
    //
    //gPosition = vec4(out_wsPos, 1.0) * g;
    //gNormal = vec4(out_normal, out_opacity) * g;
    //
    //float depthPrem = out_depth * g;
    //gDepth = vec4(depthPrem, depthPrem, depthPrem, out_opacity * g);
    //
    //gMetallicRoughness = vec4(metallicRoughness, 0, 1.0) * g;
}