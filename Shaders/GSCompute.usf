#include "/Engine/Private/Common.ush"
#include "/Engine/Private/Quaternion.ush"
#include "/Engine/Private/OctahedralCommon.ush"
#include "/Engine/Generated/GeneratedUniformBuffers.ush"


#ifndef ENABLE_RELIGHTING
#define ENABLE_RELIGHTING true
#endif


// Check isnan(value) before use.
uint order_preserving_float_map(float value)
{
    // For negative values, the mask becomes 0xffffffff.
    // For positive values, the mask becomes 0x80000000.
    uint uvalue = asuint(value);
    uint mask = -int(uvalue >> 31) | 0x80000000;
    return uvalue ^ mask;
}

float inverse_order_preserving_float_map(uint value)
{
    // If the msb is set, the mask becomes 0x80000000.
    // If the msb is unset, the mask becomes 0xffffffff.
    uint mask = ((value >> 31) - 1) | 0x80000000;
    return asfloat(value ^ mask);
}


uint PackNormal(float3 Normal)
{
	float2 OctahedronDirection = UnitVectorToOctahedron(Normal);
	return (f32tof16(OctahedronDirection.x) << 16) | f32tof16(OctahedronDirection.y);
}

float3 UnpackNormal(uint PackedNormal)
{
	return OctahedronToUnitVector(float2(f16tof32(PackedNormal >> 16), f16tof32(PackedNormal)));
}

uint PackMetallicRoughness(float2 MetallicRoughness)
{
	return (f32tof16(saturate(MetallicRoughness.x)) << 16) | f32tof16(saturate(MetallicRoughness.y));
}

float2 UnpackMetallicRoughness(uint PackedMR)
{
	return float2(f16tof32(PackedMR >> 16), f16tof32(PackedMR));
}


RWBuffer<uint> Counter;

RWBuffer<float2> OutSSPositions;
RWBuffer<float4> OutSSScale;
RWStructuredBuffer<float3> OutConic;
RWBuffer<float4> OutColorOpacity;

#if ENABLE_RELIGHTING
RWBuffer<uint> OutNormal; // Octahedron encoding 16bpc
RWBuffer<uint> OutMetallicRoughness;
#endif

RWBuffer<uint> OutDepth;
RWBuffer<uint> OutGaussianIDX;

// Capacity of buffers holding gaussian properties
uint BufferCapacity;

float SplatScaleMultiplier;


float3x3 VecToScaleMatrix(in float3 Scale)
{
	return float3x3(
		Scale.x, 0.0f, 0.0f,
		0.0f, Scale.y, 0.0f,
		0.0f, 0.0f, Scale.z
	);
}


// Mixed Rendering Pipeline
// 1. GSPrepass
// 2. Sort by view depth
// 3. SplatRasterization (VS+PS) - Renders each splat as a billboard, writing out the depth and color of each splat to the GBuffer

#ifndef THREADGROUP_SIZE_1D
#define THREADGROUP_SIZE_1D
#endif

groupshared uint GS_NumSplats;
groupshared uint GS_OutBufferStartIndex;

groupshared float2 GS_SSPositions[THREADGROUP_SIZE_1D];
groupshared float4 GS_SSScale[ THREADGROUP_SIZE_1D];
groupshared float3 GS_Conic[ THREADGROUP_SIZE_1D];
groupshared float4 GS_ColorOpacity[ THREADGROUP_SIZE_1D];

#if ENABLE_RELIGHTING
groupshared uint GS_Normal[THREADGROUP_SIZE_1D];
groupshared uint GS_MetallicRoughness[THREADGROUP_SIZE_1D];
#endif

groupshared uint GS_Depth[THREADGROUP_SIZE_1D];


[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void GSPrepass(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
    // Init counter
    if (DispatchThreadId.x == 0)
    {
        Counter[0] = 4; // 4 vertices for a quad in a triangle strip
	}

	if (GroupIndex == 0)
	{
		GS_NumSplats = 0;
	}

	GroupMemoryBarrierWithGroupSync();

	//Terminate if we are outside the bounds of our input data
    if (DispatchThreadId.x < GSResources.SplatCount)
    {
	    float4x4 ViewMatrix = PrimaryView.TranslatedWorldToView;
	    float4x4 ViewToClip = PrimaryView.ViewToClip;
	    float2 ViewSize = PrimaryView.ViewSizeAndInvSize.xy;

	    float3 Position = GSResources.Positions[DispatchThreadId.x];

	    float4 TranslatedPosition = DFTransformLocalToTranslatedWorld(Position, MakeDFMatrix4x3(Primitive.PositionHigh, Primitive.LocalToRelativeWorld), PrimaryView.PreViewTranslation);

	    TranslatedPosition.xyz *= 0.01f;

	    float4 ViewPosition = mul(TranslatedPosition, ViewMatrix);
		float4 ClipPosition = mul(ViewPosition, ViewToClip);
		ClipPosition /= ClipPosition.w;

	    float Clip = 1.0f;
		bool bClipped = ClipPosition.z < -Clip;

		if (!bClipped)
		{
			// Perspective divide to get NDC space
		    ClipPosition.xyz = ClipPosition.xyz / ClipPosition.w;

			float3x3 ScaleMatrix = VecToScaleMatrix(GSResources.Scales[DispatchThreadId.x] * Primitive.NonUniformScale.xyz * Primitive.NonUniformScale.xyz * SplatScaleMultiplier);
			float3x3 RotationMatrix = QuatToMatrix(GSResources.Orientations[DispatchThreadId.x]);

			RotationMatrix = mul((float3x3) Primitive.RelativeWorldToLocal, RotationMatrix);

		    // Calculate covariance matrix
			float3x3 T = mul(RotationMatrix, ScaleMatrix);
			float3x3 Covariance3D = mul(T, transpose(T));

		    // Calculate Jacobian matrix based off of projection matrix
			// Based off of https://jtstephens18.github.io/posts/Building-a-Gaussian-Splatting-Renderer-In-OpenGL/
			float FocalZ = ViewSize.y / (2.0f * PrimaryView.TanAndInvTanHalfFOV.y);

			float LimX = 1.3f * PrimaryView.TanAndInvTanHalfFOV.x;
			float LimY = 1.3f * PrimaryView.TanAndInvTanHalfFOV.y;

			float TxTz = ViewPosition.x / ViewPosition.z;
			float TyTz = ViewPosition.y / ViewPosition.z;

			// Clamped versions of TxTz and TyTz 
			float Tx = min(LimX, max(-LimX, TxTz)) * ViewPosition.z;
			float TY = min(LimY, max(-LimY, TyTz)) * ViewPosition.z;

			float3x3 J = float3x3(
		        FocalZ / ViewPosition.z,    0.0f,                       -(FocalZ * Tx) / (ViewPosition.z * ViewPosition.z),
		        0.0f,                       FocalZ / ViewPosition.z,    -(FocalZ * TY) / (ViewPosition.z * ViewPosition.z),
				0.0f,                       0.0f,                       0.0f
			);

			float3x3 JW = mul(J, transpose((float3x3) ViewMatrix));
			float3x3 Covariance2D = mul(JW, mul(transpose(Covariance3D), transpose(JW)));

			float X = Covariance2D[0][0] + 0.3f;
			float Y = Covariance2D[1][1] + 0.3f;
			float Covariance = Covariance2D[0][1];

		    // Determine conic for the splat
			float Determinant = X * Y - Covariance * Covariance;
			float3 Conic = float3(Y, Covariance, X) / Determinant;

		    // Finally calculate the bounds of a screenspace quad that will be rasterized for this splat
			float Mid = (X + Y);
			float Delta = length(float2((X - Y), (2 * Covariance)));
			
		    float Lambda1 = 0.5f * (Mid + Delta);
		    float Lambda2 = 0.5f * (Mid - Delta);

		    if (Lambda2 > 0.0f)
		    {
				float2 DiagonalVector = normalize(float2((Covariance - Y + Lambda1), (-X + Covariance + Lambda1)));
				float2 MajorAxis = min(3 * sqrt(Lambda1), 1024.0f) * DiagonalVector;
				float2 MinorAxis = min(3 * sqrt(Lambda2), 1024.0f) * float2(DiagonalVector.y, -DiagonalVector.x);
				
				float2 MajorAxisMultiplier = MajorAxis / (ViewSize * 0.5f);
				float2 MinorAxisMultiplier = MinorAxis / (ViewSize * 0.5f);

				// Check if screen space quad is on-screen
				// TODO: I'm sure this can be done in less operations
				float2 V00 = ClipPosition.xy + (-1 * MinorAxisMultiplier + -1 * MajorAxisMultiplier);
				float2 V10 = ClipPosition.xy + ( 1 * MinorAxisMultiplier + -1 * MajorAxisMultiplier);
				float2 V01 = ClipPosition.xy + (-1 * MinorAxisMultiplier +  1 * MajorAxisMultiplier);
				float2 V11 = ClipPosition.xy + ( 1 * MinorAxisMultiplier +  1 * MajorAxisMultiplier);
				float2 Min = min(min(V00, V10), min(V01, V11));
				float2 Max = max(max(V00, V10), max(V01, V11));

				if (all(and(Min < 1.0f, Max.x > -1.0f)))
				{
					// Write splat properties to groupshared memory
					uint Index;
					InterlockedAdd(GS_NumSplats, 1, Index);

					GS_SSPositions[Index] = ClipPosition.xy;
					GS_SSScale[Index] = float4(MajorAxisMultiplier, MinorAxisMultiplier);
					GS_Conic[Index] = Conic;
	        
					GS_ColorOpacity[Index] = GSResources.SHAndOpacities[DispatchThreadId.x];

					GS_Depth[Index] = order_preserving_float_map(ViewPosition.z);

#if ENABLE_RELIGHTING
					float3 WorldSpaceNormal = mul((float3x3) Primitive.RelativeWorldToLocal, GSResources.Normals[DispatchThreadId.x]);
					GS_Normal[Index] = PackNormal(WorldSpaceNormal);
					GS_MetallicRoughness[Index] = PackMetallicRoughness(GSResources.MetallicRoughness[DispatchThreadId.x]);
#endif
				}
			}
		}
    }

	GroupMemoryBarrierWithGroupSync();

    // Output properties of screenspace quad and projected gaussians

	// Allocate space in global buffer
	if (GroupIndex == 0 && GS_NumSplats > 0)
	{
		InterlockedAdd(Counter[1], GS_NumSplats, GS_OutBufferStartIndex);
		if (GS_OutBufferStartIndex >= BufferCapacity)
		{
			uint Dummy;
			InterlockedExchange(Counter[1], BufferCapacity, Dummy);

			GS_NumSplats = 0;
		}
	}

	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex < GS_NumSplats)
	{
		uint Idx = GS_OutBufferStartIndex + GroupIndex;

		OutSSPositions[Idx] = GS_SSPositions[GroupIndex];
		OutSSScale[Idx] = GS_SSScale[GroupIndex];
		OutConic[Idx] = GS_Conic[GroupIndex];
        
		OutGaussianIDX[Idx] = Idx;
		OutColorOpacity[Idx] = GS_ColorOpacity[GroupIndex];

		OutDepth[Idx] = GS_Depth[GroupIndex];

#if ENABLE_RELIGHTING
		OutNormal[Idx] = GS_Normal[GroupIndex];
		OutMetallicRoughness[Idx] = GS_MetallicRoughness[GroupIndex];
#endif
	}
}

Buffer<float2> VS_SSPositions;
Buffer<float4> VS_SSScale;
StructuredBuffer<float3> VS_Conic;

Buffer<float4> VS_ColorOpacity;

Buffer<uint> VS_Depth;

#if ENABLE_RELIGHTING
Buffer<uint> VS_MetallicRoughness;
Buffer<uint> VS_Normal; // Octahedron encoding 16bpc
#endif

Buffer<uint> VS_GaussianIDX;

struct FOutVertex
{
	float4 Position : SV_POSITION;
	float2 Mean : MEAN;

    float3 Color : COLOR;
	float3 Conic : CONIC;
    float Opacity : OPACITY;

	float DeviceZ : DEPTH;

#if ENABLE_RELIGHTING
    float2 MR : METALLICROUGHNESS;
    float3 Normal : NORMAL_MEAN;
#else
	// For velocity calculation
	float2 PositionNDC : POSITION_NDC;
#endif
};


static float2 Quad[4] =
{
	float2(-1, -1),
	float2(-1, 1),
	float2(1, -1),
	float2(1, 1)
};

FOutVertex GSSplatting_VS(uint GlobalVertexId : SV_VertexID, uint InstanceID : SV_InstanceID )
{
    uint Index = VS_GaussianIDX[InstanceID];

    FOutVertex Output;

    Output.Color = VS_ColorOpacity[Index].rgb;
    Output.Opacity = VS_ColorOpacity[Index].a;

    float3 Conic = VS_Conic[Index];
	Output.Conic = float3(-0.5 * Conic.x, -Conic.y, -0.5 * Conic.z);

    float4 QuadScale = VS_SSScale[Index];
    float2 ScreenSpacePos = VS_SSPositions[Index];
    float2 Vertex = Quad[GlobalVertexId];

	Output.Mean = float2((float2(ScreenSpacePos.x, -ScreenSpacePos.y) + 1) * 0.5f * PrimaryView.ViewSizeAndInvSize.xy);
    Output.Position = float4(ScreenSpacePos.xy + (Vertex.x * QuadScale.zw + Vertex.y * QuadScale.xy), 0, 1);

    // Must invert bits for unlit splats as they are sorted in opposite order
	float SceneDepth = inverse_order_preserving_float_map(VS_Depth[InstanceID]);
	// Multiply by 100 to convert to centimetres
	Output.DeviceZ = ConvertToDeviceZ(100.0f * SceneDepth);

#if ENABLE_RELIGHTING
	Output.MR = UnpackMetallicRoughness(VS_MetallicRoughness[Index]);
	Output.Normal = UnpackNormal(VS_Normal[Index]);
#else
	Output.PositionNDC = Output.Position.xy - PrimaryView.TemporalAAJitter.xy * PrimaryView.ViewSizeAndInvSize.zw;
#endif

    return Output;
}


struct FRTOut
{
    float4 Color : SV_TARGET0;
    
#if ENABLE_RELIGHTING
    float4 Normal : SV_TARGET1;
    float4 MetallicRoughness : SV_TARGET2;
    float DeviceZ : SV_TARGET3;
#else
    float4 Velocity : SV_TARGET1;
	float DeviceZ : SV_Depth;
#endif

};
 
FRTOut GSSplatting_PS(FOutVertex Input)
{
	FRTOut Output;

    float2 DistanceFromMean = (Input.Mean.xy - Input.Position.xy);

    float Power = dot(Input.Conic.xzy, float3(DistanceFromMean * DistanceFromMean, DistanceFromMean.x * DistanceFromMean.y));
    float Alpha = exp(Power) * Input.Opacity;

	Output.Color = float4(Input.Color * Alpha, Alpha);

#if ENABLE_RELIGHTING
    Output.Normal = float4(Input.Normal * Alpha, Alpha);
    Output.MetallicRoughness = float4(Input.MR * Alpha, 0, Alpha);
#else
	// Must write out velocity for TAA/TSR for unlit splats, as they do not write depth information where velocity can be reconstructed from
	float4 Clip = float4(Input.PositionNDC, Input.DeviceZ, 1.0f);
	// ClipToPrevClip does not include AA jitter
	float4 PrevClip = mul(Clip, PrimaryView.ClipToPrevClip);
	PrevClip.xyz /= PrevClip.w;
	float3 Velocity = float3(Input.PositionNDC - PrevClip.xy, Input.DeviceZ - PrevClip.z);

	Output.Velocity = EncodeVelocityToTexture(Velocity);
#endif

    // For lit splats, will output to depth component of GSplatGBuffer
	// For unlit splats, only used to test against scene depth and not written to depth buffer
	Output.DeviceZ = Input.DeviceZ;

    return Output;
}
