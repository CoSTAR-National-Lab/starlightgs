struct Barycentric
{
    float a0;
    float a1;
    float a2;
    float a3;
    float a4;
    float a5;
};

int {ParameterName}_FrostingSplatCount;
StructuredBuffer<Barycentric> {ParameterName}_Barycentrics;
Buffer<int> {ParameterName}_FaceIndex;
Buffer<float3> {ParameterName}_Scales;
Buffer<float4> {ParameterName}_Orientations; 
Buffer<float4> {ParameterName}_SHAndOpacities;

void GetFrostingSplatCount_{ParameterName}(out int Count)
{
  Count = {ParameterName}_FrostingSplatCount;
}

