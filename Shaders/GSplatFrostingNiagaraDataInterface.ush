//}


void GetFrostingData_{ParameterName}(in int Index, out int FaceIndex, out float3 Scale, out float4 Orientation, out float4 SHAndOpacity)
{
	FaceIndex		=	{ParameterName}_FaceIndex[ Index];
	Scale			=	{ParameterName}_Scales[Index];
	Orientation		=	{ParameterName}_Orientations[Index].rgba;
	SHAndOpacity =		{ParameterName}_SHAndOpacities[Index].rgba;
}

void GetFrostingBarycentricData_{ParameterName}(in int Index,out float a0, out float a1, out float a2,out float a3,out float a4,out float a5 )
{
	Barycentric A = {ParameterName}_Barycentrics[Index];

	a0 = A.a0;
	a1 = A.a1;
	a2 = A.a2;
	a3 = A.a3;
	a4 = A.a4;
	a5 = A.a5;
}












